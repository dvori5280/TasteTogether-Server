<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<variable name="logLayout"
			  value="${date:format=yyyy-MM-dd HH\:mm\:ss}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

	<targets>
		<target xsi:type="Console" name="console" layout="${logLayout}" />

		<target xsi:type="File" name="file"
				fileName="${basedir}/logs/app-${shortdate}.log"
				layout="${logLayout}"
				maxArchiveFiles="7"
				encoding="utf-8" />
	</targets>

	<rules>
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="*" minlevel="Info" writeTo="console,file" />
	</rules>
</nlog>